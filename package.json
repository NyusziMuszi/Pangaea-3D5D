{
  "name": "pangaea",
  "version": "0.1.0",
  "description": "Create 1080x1350 Instagram videos with shader/3D animation of an image and colored text cards",
  "main": "./out/main/index.js",
  "author": "Eszter Muray",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "mp4-muxer": "^5.1.5",
    "three": "^0.184.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.1",
    "react-colorful": "^5.6.1"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@types/dom-webcodecs": "^0.1.13",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.eszter.pangaea",
    "productName": "Pangaea",
    "directories": { "output": "dist" },
    "files": ["out/**/*"],
    "asarUnpack": ["**/node_modules/ffmpeg-static/**"],
    "mac": {
      "category": "public.app-category.video",
      "icon": "assets/electron-icons/macos/icon.icns",
      "target": [{ "target": "dmg", "arch": ["arm64"] }]
    }
  }
}
